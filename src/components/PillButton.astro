---
interface Props {
	text: string;
	href: string;
	active?: boolean;
	inverted?: boolean;
	target?: '_blank';
	rel?: string;
}

const { text, href, active = false, inverted = false, target, rel } = Astro.props;
const hasIcon = Astro.slots.has('icon');
---

<a
	class:list={['pill-button', { 'pill-button--inverted': inverted }]}
	href={href}
	target={target}
	rel={rel}
	aria-current={active ? 'page' : undefined}
>
	<span>{text}</span>
	{
		hasIcon && (
			<span class="pill-button__icon" aria-hidden="true">
				<slot name="icon" />
			</span>
		)
	}
</a>

<style>
	.pill-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		text-decoration: none;
		transition: border-color 160ms ease;
		white-space: nowrap;
	}

	.pill-button[aria-current='page'],
	.pill-button--inverted {
		background: var(--foreground);
		color: var(--background);
	}

	.pill-button:hover {
		border-color: var(--foreground);
	}

	.pill-button__icon {
		width: 0.8em;
		height: 0.8em;
	}

	.pill-button__icon :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
