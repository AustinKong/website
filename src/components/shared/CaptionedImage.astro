---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	caption: string;
	size?: 'large' | 'medium' | 'small';
}

const { src, caption, size = 'large' } = Astro.props;
const maxWidth = { large: 960, medium: 720, small: 480 }[size];
---

<figure class={size}>
	<Image {src} alt={caption} width={maxWidth} />
	<figcaption>{caption}</figcaption>
</figure>

<style>
	figure {
		margin: 2rem auto;
	}

	figure.large {
		width: 100%;
	}

	figure.medium {
		width: 75%;
	}

	figure.small {
		width: 50%;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-card);
	}

	figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: var(--font-size-small);
	}

	@media (max-width: 40rem) {
		figure:is(.medium, .small) {
			width: 100%;
		}
	}
</style>
