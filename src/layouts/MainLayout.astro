---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	showNavbar?: boolean;
}

const { title, description, showNavbar = true } = Astro.props;
---

<Layout title={title} description={description}>
	<div class="page-shell">
		{showNavbar && <Navbar />}
		<main>
			<slot />
		</main>
		<Footer />
	</div>
</Layout>

<style>
	.page-shell {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		min-height: 0;
	}
</style>
