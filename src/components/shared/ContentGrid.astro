---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Laurel from './Laurel.astro';

interface Item {
	title: string;
	href: string;
	description: string;
	image: ImageMetadata;
	imageAlt: string;
	stat?: string;
	target?: '_blank';
}

interface Props {
	items: Item[];
	cardHeadingLevel?: 2 | 3;
}

const { items, cardHeadingLevel = 2 } = Astro.props;
const CardHeading = cardHeadingLevel === 2 ? 'h2' : 'h3';
---

<div class="content-grid">
	{
		items.map((item) => (
			<article class="content-card">
				<a
					class="content-card__link"
					href={item.href}
					target={item.target}
					rel={item.target && 'noreferrer'}
				>
					<div class="content-card__media">
						<Image src={item.image} alt={item.imageAlt} width={480} />
					</div>

					<div class="content-card__heading">
						<CardHeading class="content-card__title">{item.title}</CardHeading>
						{
							item.stat && (
								<div class="content-card__stat">
									<Laurel text={item.stat} />
								</div>
							)
						}
					</div>
					<p>{item.description}</p>
				</a>
			</article>
		))
	}
</div>

<style>
	.content-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 3.5rem 1rem;
	}

	.content-card__media {
		display: grid;
		aspect-ratio: 9 / 10;
		margin-bottom: 1rem;
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--surface);
	}

	.content-card__link {
		display: block;
		text-decoration: none;
	}

	.content-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.content-card__title {
		flex-shrink: 0;
		margin: 0;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.18em;
		transition: text-decoration-color var(--transition);
	}

	.content-card__stat {
		min-width: 0;
	}

	.content-card__heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.25rem;
	}

	.content-card__link:hover .content-card__title,
	.content-card__link:focus-visible .content-card__title {
		text-decoration-color: currentColor;
	}

	.content-card p {
		margin: 0;
	}
</style>
