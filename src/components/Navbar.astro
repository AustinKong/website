---
import Profile from './Profile.astro';

interface Props {
	items?: {
		label: string;
		href: string;
		depth?: number;
	}[];
}

const { items = [] } = Astro.props;
---

<aside class="sidebar">
	<Profile />

	{
		items.length > 0 && (
			<nav class="desktop-nav" aria-label="On this page">
				<h2>On this page</h2>
				<div class="nav-links">
					{items.map((item, index) => (
						<a
							class="nav-link"
							href={item.href}
							style={`--nav-indent: ${Math.max(0, (item.depth ?? 2) - 2)}rem`}
							aria-current={index === 0 ? 'page' : undefined}
						>
							{item.label}
						</a>
					))}
				</div>
			</nav>
		)
	}
</aside>

<script>
	const sectionLinks = [
		...document.querySelectorAll<HTMLAnchorElement>(
			'.desktop-nav a[href*="#"]'
		),
	];
	const sections = sectionLinks
		.map((link) => document.querySelector<HTMLElement>(link.hash))
		.filter((section): section is HTMLElement => section !== null);
	const nav = sectionLinks[0]?.closest<HTMLElement>('.nav-links');
	let currentLink: HTMLAnchorElement | undefined;

	if (sections.length && nav) {
		const updateActiveSection = () => {
			const active =
				scrollY + innerHeight >= document.documentElement.scrollHeight - 1
					? sections.at(-1)
					: (sections.findLast(
							(section) =>
								section.getBoundingClientRect().top <= innerHeight * 0.4
						) ?? sections[0]);
			if (!active) return;

			const activeLink = sectionLinks.find(
				(link) => link.hash === `#${active.id}`
			);

			sectionLinks.forEach((link) => {
				if (link === activeLink) link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			});

			if (activeLink && activeLink !== currentLink) {
				currentLink = activeLink;
				const navRect = nav.getBoundingClientRect();
				const linkRect = activeLink.getBoundingClientRect();

				if (linkRect.top < navRect.top)
					nav.scrollBy({ top: linkRect.top - navRect.top, behavior: 'smooth' });
				else if (linkRect.bottom > navRect.bottom)
					nav.scrollBy({
						top: linkRect.bottom - navRect.bottom,
						behavior: 'smooth',
					});
			}
		};

		updateActiveSection();
		addEventListener('scroll', updateActiveSection, { passive: true });
	}
</script>

<style>
	.sidebar {
		position: sticky;
		top: 0;
		display: flex;
		height: 100vh;
		flex-direction: column;
		align-items: flex-start;
		padding: 3rem 2rem 1.25rem;
	}

	.desktop-nav {
		display: flex;
		width: 100%;
		min-height: 0;
		margin-top: 3rem;
		flex-direction: column;
		gap: 1.5rem;
	}

	.nav-links {
		display: grid;
		min-height: 0;
		gap: 1rem;
		overflow-y: auto;
		scrollbar-width: none;
	}

	.nav-links::-webkit-scrollbar {
		display: none;
	}

	.desktop-nav h2 {
		margin: 0;
		font-size: inherit;
	}

	.nav-link {
		padding-left: var(--nav-indent);
		color: var(--muted);
		font-size: var(--font-size-small);
		overflow-wrap: anywhere;
		text-decoration: none;
		transition: color var(--transition);
	}

	.nav-link:hover,
	.nav-link[aria-current='page'] {
		color: var(--foreground);
	}

	@media (max-width: 900px) {
		.sidebar {
			display: none;
		}
	}
</style>
