---
interface Props {
	class?: string;
	iconSize?: string;
	lineHeight?: string;
	underlineOffset?: string;
	underlineThickness?: string;
	popoutSpread?: string;
	popoutLiftMin?: string;
	popoutLiftMax?: string;
	rotateMinDeg?: number;
	rotateMaxDeg?: number;
}

const {
	class: className = '',
	iconSize = '32px',
	lineHeight = 'inherit',
	underlineOffset = '0.12em',
	underlineThickness = '0.085em',
	popoutSpread = '0.42em',
	popoutLiftMin = '0.06rem',
	popoutLiftMax = '0.78rem',
	rotateMinDeg = -7,
	rotateMaxDeg = 7,
} = Astro.props;
---

<span
	class:list={['underline-popout', className]}
	data-underline-popout
	style={`--underline-popout-icon-size:${iconSize}; --underline-popout-line-height:${lineHeight}; --underline-popout-underline-offset:${underlineOffset}; --underline-popout-underline-thickness:${underlineThickness}; --underline-popout-spread:${popoutSpread}; --underline-popout-lift-min:${popoutLiftMin}; --underline-popout-lift-max:${popoutLiftMax}; --underline-popout-rotate-min:${rotateMinDeg}; --underline-popout-rotate-max:${rotateMaxDeg};`}
>
	<span class="underline-popout__icon" aria-hidden="true">
		<slot name="icon" />
	</span>
	<span class="underline-popout__text">
		<slot />
	</span>
</span>

<script is:inline>
	(() => {
		const randomBetween = (min, max) => Math.random() * (max - min) + min;
		const parseValue = (rawValue, fallback) => {
			const parsed = Number.parseFloat(rawValue);

			if (Number.isNaN(parsed)) {
				return fallback;
			}

			return parsed;
		};

		const bindPopout = (node) => {
			if (
				!(node instanceof HTMLElement) ||
				node.dataset.popoutBound === 'true'
			) {
				return;
			}

			node.dataset.popoutBound = 'true';

			node.addEventListener('pointerenter', () => {
				const styles = getComputedStyle(node);
				const spread = parseValue(
					styles.getPropertyValue('--underline-popout-spread'),
					0.42
				);
				const liftMin = parseValue(
					styles.getPropertyValue('--underline-popout-lift-min'),
					0.36
				);
				const liftMax = parseValue(
					styles.getPropertyValue('--underline-popout-lift-max'),
					0.98
				);
				const rotateMin = parseValue(
					styles.getPropertyValue('--underline-popout-rotate-min'),
					-7
				);
				const rotateMax = parseValue(
					styles.getPropertyValue('--underline-popout-rotate-max'),
					7
				);

				const x = randomBetween(-spread, spread);
				const y = -randomBetween(liftMin, liftMax);
				const rotation = randomBetween(rotateMin, rotateMax);

				node.style.setProperty('--underline-popout-x', `${x.toFixed(3)}em`);
				node.style.setProperty('--underline-popout-y', `${y.toFixed(3)}em`);
				node.style.setProperty(
					'--underline-popout-rotate',
					`${rotation.toFixed(2)}deg`
				);
				node.dataset.active = 'true';
			});

			node.addEventListener('pointerleave', () => {
				node.dataset.active = 'false';
			});
		};

		document
			.querySelectorAll('[data-underline-popout]')
			.forEach((node) => bindPopout(node));
	})();
</script>

<style is:global>
	.underline-popout {
		position: relative;
		display: inline;
		font: inherit;
		line-height: var(--underline-popout-line-height);
		vertical-align: baseline;
		isolation: isolate;
		--underline-popout-x: 0rem;
		--underline-popout-y: -0.4em;
		--underline-popout-rotate: 0deg;
	}

	.underline-popout__text {
		position: relative;
		z-index: 2;
		display: inline;
		font: inherit;
		line-height: inherit;
		text-decoration: underline;
		text-decoration-thickness: var(--underline-popout-underline-thickness);
		text-underline-offset: var(--underline-popout-underline-offset);
	}

	.underline-popout__icon {
		position: absolute;
		left: 50%;
		top: 50%;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--underline-popout-icon-size);
		height: var(--underline-popout-icon-size);
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, -45%) scale(0.72) rotate(0deg);
		transition:
			opacity 180ms ease,
			transform 280ms cubic-bezier(0.2, 0.75, 0.22, 1.1);
	}

	.underline-popout__icon > * {
		display: block;
		width: 100%;
		height: 100%;
	}

	.underline-popout__icon :is(svg, img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.underline-popout[data-active='true'] .underline-popout__icon,
	.underline-popout:hover .underline-popout__icon {
		opacity: 1;
		transform: translate(
				calc(-50% + var(--underline-popout-x)),
				calc(-122% + var(--underline-popout-y))
			)
			scale(1) rotate(var(--underline-popout-rotate));
	}
</style>
