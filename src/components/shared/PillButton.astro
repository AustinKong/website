---
interface Props {
	href: string;
	inverted?: boolean;
	target?: '_blank';
	rel?: string;
}

const { href, inverted = false, target, rel } = Astro.props;
---

<a
	class:list={['pill-button', { 'pill-button--inverted': inverted }]}
	href={href}
	target={target}
	rel={rel}
>
	<slot />
</a>

<style>
	.pill-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 1rem;
		border: 1px solid var(--subtle);
		border-radius: var(--radius-pill);
		background: var(--white);
		text-decoration: none;
		transition: border-color var(--transition);
		white-space: nowrap;
	}

	.pill-button--inverted {
		background: var(--foreground);
		color: var(--background);
	}

	.pill-button--inverted :global(img) {
		filter: brightness(0) invert(1);
	}

	.pill-button:hover {
		border-color: var(--foreground);
	}
</style>
