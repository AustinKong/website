---
interface GalleryObject {
	src: string;
	alt: string;
	caption: string;
	link?: {
		text: string;
		href: string;
	};
}

interface Props {
	objects: GalleryObject[];
}

const { objects } = Astro.props;
---

<div>
	{
		objects.map((object) => (
			<figure>
				<img src={object.src} alt={object.alt} loading="lazy" />
				<figcaption>
					{object.caption}
					{object.link && (
						<>
							{' '}
							<a href={object.link.href}>{object.link.text}</a>
						</>
					)}
				</figcaption>
			</figure>
		))
	}
</div>

<style>
	div {
		display: flex;
		margin: 3rem 0;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		gap: clamp(1rem, 4vw, 4rem);
	}

	figure {
		--rotation: -3deg;

		flex: 0 1 12rem;
		margin: 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 22rem;
		object-fit: contain;
		filter: drop-shadow(0 1rem 0.75rem var(--shadow));
		transform: rotate(var(--rotation));
		transition: transform var(--transition);
	}

	figure:nth-child(3n + 2) {
		--rotation: 3deg;
	}

	figure:nth-child(3n) {
		--rotation: -2deg;
	}

	figure:is(:hover, :focus-within) img {
		transform: translateY(-0.25rem) rotate(calc(var(--rotation) + 1.5deg));
	}

	figcaption {
		margin-top: 1rem;
		color: var(--foreground);
		text-align: center;
		transition:
			opacity var(--transition),
			transform var(--transition);
		white-space: pre-line;
	}

	@media (hover: hover) {
		figcaption {
			opacity: 0;
			pointer-events: none;
			transform: translateY(-0.5rem);
		}

		figure:is(:hover, :focus-within) figcaption {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}
	}
</style>
