---
import { Image } from 'astro:assets';
import profilePicture from '../assets/profile-picture.jpg';
import PillButton from './PillButton.astro';

const links = [
	{ label: 'About', href: '/#about' },
	{ label: 'Experience', href: '/#experience' },
	{ label: 'Projects', href: '/#projects' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'Contact', href: '/#contact' },
];

const pathname = Astro.url.pathname;
---

<aside class="sidebar">
	<a class="profile" href="/">
		<Image src={profilePicture} alt="" width={96} height={96} />
		<span class="profile__text">
			<span class="profile__name-row">
				<span class="profile__name">Austin Kong</span>
				<span class="profile__verified" aria-label="Verified">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="M12 1.5l2.1 1.7 2.7-.2 1 2.5 2.4 1.3-.6 2.7 1.3 2.5-1.7 2.1.2 2.7-2.5 1-1.3 2.4-2.7-.6-2.5 1.3-2.1-1.7-2.7.2-1-2.5-2.4-1.3.6-2.7L3.1 12l1.7-2.1-.2-2.7 2.5-1 1.3-2.4 2.7.6L12 1.5z"
						></path>
						<path d="M8 12.1l2.4 2.4 5.6-5.6"></path>
					</svg>
				</span>
			</span>
			<span class="profile__role">Final Year Information Systems @ NUS</span>
		</span>
	</a>

	<nav class="desktop-nav" aria-label="Primary">
		{
			links.map((link) => (
				<PillButton
					text={link.label}
					href={link.href}
					active={
						(link.label === 'About' && pathname === '/') ||
						(link.href === '/blog' && pathname.startsWith('/blog'))
					}
				/>
			))
		}
	</nav>

</aside>

<script>
	const sectionLinks = [
		...document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a[href^="/#"]'),
	];
	const sections = sectionLinks
		.map((link) => document.querySelector<HTMLElement>(link.hash))
		.filter((section): section is HTMLElement => section !== null);

	if (sections.length) {
		const updateActiveSection = () => {
			const active =
				sections.findLast(
					(section) => section.getBoundingClientRect().top <= innerHeight * 0.4,
				) ?? sections[0];

			sectionLinks.forEach((link) => {
				if (link.hash === `#${active.id}`) link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			});
		};

		updateActiveSection();
		addEventListener('scroll', updateActiveSection, { passive: true });
	}
</script>

<style>
	.sidebar {
		position: sticky;
		top: 0;
		display: flex;
		height: 100vh;
		flex-direction: column;
		align-items: flex-start;
		padding: 3rem 2rem 1.25rem;
	}

	.profile {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		text-decoration: none;
	}

	.profile img {
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		object-fit: cover;
	}

	.profile__text {
		display: grid;
		gap: 0.15rem;
	}

	.profile__name-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.profile__name {
		font-size: var(--font-size-h2);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	.profile__verified {
		width: 1.2rem;
		height: 1.2rem;
		flex: none;
	}

	.profile__verified svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.profile__verified svg path:first-child {
		fill: #1da1f2;
		stroke: none;
	}

	.profile__verified svg path:last-child {
		fill: none;
		stroke: #ffffff;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.profile__role {
		color: var(--muted);
	}

	.desktop-nav {
		display: flex;
		width: 100%;
		margin-top: 3rem;
		flex-flow: row wrap;
		gap: 0.5rem;
		line-height: 1.25;
	}

	@media (max-width: 900px) {
		.sidebar {
			position: static;
			min-height: 4.5rem;
			height: auto;
			flex-direction: row;
			align-items: center;
			padding: 0.75rem 1.25rem;
		}

		.profile {
			flex-direction: row;
			align-items: center;
			gap: 0.75rem;
		}

		.profile img {
			width: 3rem;
			height: 3rem;
		}

		.profile__role {
			font-size: 0.8rem;
		}

		.desktop-nav {
			display: none;
		}
	}
</style>
