---
import type { ImageMetadata } from 'astro';

interface CarouselImage {
	src: string | ImageMetadata;
	alt: string;
	caption: string;
}

interface Props {
	images: CarouselImage[];
}

const { images } = Astro.props;
const firstImage = images[0]?.src;
const aspectRatio =
	firstImage && typeof firstImage !== 'string'
		? `${firstImage.width} / ${firstImage.height}`
		: '4 / 3';
---

{
	images.length > 0 && (
		<figure
			class="stacked-carousel"
			data-stacked-carousel
			style={`--carousel-aspect-ratio: ${aspectRatio}`}
		>
			<button
				type="button"
				aria-label="Show next image"
				disabled={images.length < 2}
			>
				<span class="stack">
					{images.map(({ src, alt, caption }) => (
						<span class="card" data-caption={caption}>
							<img
								src={typeof src === 'string' ? src : src.src}
								width={typeof src === 'string' ? undefined : src.width}
								height={typeof src === 'string' ? undefined : src.height}
								alt={alt}
								loading="lazy"
								draggable="false"
							/>
						</span>
					))}
				</span>
			</button>
			<figcaption aria-live="polite">{images[0].caption}</figcaption>
		</figure>
	)
}

<script>
	document
		.querySelectorAll<HTMLElement>('[data-stacked-carousel]')
		.forEach((carousel) => {
			if (carousel.dataset.ready) return;
			carousel.dataset.ready = 'true';

			const button = carousel.querySelector('button');
			const stack = carousel.querySelector('.stack');
			const caption = carousel.querySelector('figcaption');
			let cycle = 0;
			let moving = false;

			button?.addEventListener('click', () => {
				const card = stack?.firstElementChild as HTMLElement | null;
				if (!card || !stack || !caption || moving) return;

				moving = true;
				card.dataset.exit = String(cycle++ % 4);
				card.addEventListener(
					'animationend',
					() => {
						stack.append(card);
						card.dataset.returning = '';
						caption.textContent =
							(stack.firstElementChild as HTMLElement | null)?.dataset
								.caption ?? '';
						card.addEventListener(
							'animationend',
							() => {
								delete card.dataset.exit;
								delete card.dataset.returning;
								moving = false;
							},
							{ once: true }
						);
					},
					{ once: true }
				);
			});
		});
</script>

<style>
	.stacked-carousel {
		width: min(100%, 36rem);
		margin: 3rem auto;
		text-align: center;
	}

	button {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		cursor: pointer;
	}

	button:disabled {
		cursor: default;
	}

	.stack {
		position: relative;
		display: block;
		aspect-ratio: var(--carousel-aspect-ratio);
	}

	button:is(:hover, :focus-visible) .card:first-child {
		transform: translateY(-0.4rem) rotate(1deg) scale(1);
	}

	button:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 0.75rem;
	}

	.card {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		transition:
			opacity 280ms ease,
			transform 280ms ease;
	}

	.card:nth-child(1) {
		z-index: 4;
		opacity: 1;
		transform: translate(0) scale(1);
	}

	.card:nth-child(2) {
		z-index: 3;
		opacity: 0.96;
		transform: translate(-3%, 1%) rotate(-1.5deg) scale(0.99);
	}

	.card:nth-child(3) {
		z-index: 2;
		opacity: 0.92;
		transform: translate(3%, 2%) rotate(1.5deg) scale(0.98);
	}

	.card:nth-child(4) {
		z-index: 1;
		opacity: 0.88;
		transform: translate(-1.5%, 3%) rotate(-1deg) scale(0.97);
	}

	.card:nth-child(n + 5) {
		visibility: hidden;
	}

	img {
		display: block;
		width: 100%;
		height: 100%;
		border-radius: var(--radius-card);
		background: var(--white);
		box-shadow: 0 1rem 2rem var(--shadow);
		object-fit: contain;
		user-select: none;
	}

	.card[data-exit='0'] {
		--exit-x: -72%;
		--exit-rotation: -8deg;
	}

	.card[data-exit='1'] {
		--exit-x: 72%;
		--exit-rotation: 8deg;
	}

	.card[data-exit='2'] {
		--exit-x: -80%;
		--exit-rotation: -11deg;
	}

	.card[data-exit='3'] {
		--exit-x: 80%;
		--exit-rotation: 11deg;
	}

	.card[data-exit] {
		animation: slide-card-out 240ms ease-in forwards;
	}

	.card[data-returning] {
		z-index: 0;
		visibility: visible;
		animation: return-card 280ms ease-out forwards;
	}

	figcaption {
		margin-top: 1.5rem;
	}

	@keyframes slide-card-out {
		to {
			opacity: 0.72;
			transform: translateX(var(--exit-x)) rotate(var(--exit-rotation))
				scale(0.97);
		}
	}

	@keyframes return-card {
		from {
			opacity: 0.72;
			transform: translateX(var(--exit-x)) rotate(var(--exit-rotation))
				scale(0.97);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}

		.card[data-exit] {
			animation-duration: 1ms;
		}
	}
</style>
