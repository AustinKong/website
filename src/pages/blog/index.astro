---
import { getCollection } from 'astro:content';
import ArrowLeft from '../../assets/arrow-left.svg';
import InlineIcon from '../../components/shared/InlineIcon.astro';
import ContentGrid from '../../components/shared/ContentGrid.astro';
import PillButton from '../../components/shared/PillButton.astro';
import MainLayout from '../../layouts/MainLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const items = posts.map((post) => ({
	title: post.data.title,
	description: post.data.description,
	href: `/blog/${post.id}`,
	image: post.data.image,
	imageAlt: post.data.imageAlt,
}));
---

<MainLayout title="Blog — Austin Kong" description="Notes from Austin Kong.">
	<nav aria-label="Back">
		<PillButton href="/" inverted>
			<InlineIcon src={ArrowLeft.src} />
			Home
		</PillButton>
	</nav>
	<section>
		<h1>Blog</h1>
		<ContentGrid items={items} />
	</section>
</MainLayout>

<style>
	nav {
		margin-bottom: 2rem;
	}
</style>
