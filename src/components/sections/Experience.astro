---
import arrowIcon from '../../assets/arrow-top-right.svg?raw';
import azure from '../../assets/icons/azure.svg';
import csharp from '../../assets/icons/csharp.svg';
import docker from '../../assets/icons/docker.svg';
import dotnet from '../../assets/icons/dotnet.svg';
import express from '../../assets/icons/express.svg';
import fastapi from '../../assets/icons/fastapi.svg';
import java from '../../assets/icons/java.svg';
import kubernetes from '../../assets/icons/kubernetes.svg';
import gic from '../../assets/experience/gic.png';
import psa from '../../assets/experience/psa.png';
import nus from '../../assets/experience/nus.png';
import python from '../../assets/icons/python.svg';
import react from '../../assets/icons/react.svg';
import sql from '../../assets/icons/sql.svg';
import typescript from '../../assets/icons/typescript.svg';
import unity from '../../assets/icons/unity.svg';
import InlineIcon from '../shared/InlineIcon.astro';
import PillButton from '../shared/PillButton.astro';
import TechTag from '../shared/TechTag.astro';
---

<section id="experience" class="home-section section--narrow">
	<h2>Experience</h2>
	<PillButton
		text="View my resume"
		href="/Kong_Hoi_Tec_Resume.pdf"
		inverted
		target="_blank"
		rel="noopener"
	>
		<span slot="icon" set:html={arrowIcon} />
	</PillButton>

	<ol class="timeline">
		<li>
			<h3>
				National University of Singapore
				<InlineIcon src={nus.src} />
			</h3>
			<p class="experience-meta">
				<span>Teaching Assistant</span>
				<span>Aug 2025 - Present</span>
			</p>
			<p>
				I currently serve as a Teaching Assistant for CS2040 (Data Structures
				and Algorithms), facilitating weekly lab sessions and mentoring students
				through Java-based programming exercises, helping students approach
				algorithmic thinking from different perspectives.
			</p>
			<div class="tech-tags" role="group" aria-label="Technologies used">
				<TechTag src={java.src} label="Java" />
			</div>
		</li>

		<li>
			<h3>
				GIC
				<InlineIcon src={gic.src} />
			</h3>
			<p class="experience-meta">
				<span>Full-Stack Software Engineer Intern</span>
				<span>Jan 2026 - Jun 2026</span>
			</p>
			<p>
				I joined Public Equities Technology at GIC, where I built production
				software supporting investment teams across the firm. Over the
				internship, I took on full-stack features, resilient backend workflows,
				and internal platforms, gradually owning projects from requirements
				gathering through to production deployment.
			</p>
			<p>
				Some of the work I am most proud of includes a fault-tolerant caching
				workflow that reduced manual effort by 93%, a self-service metadata
				platform that turned a recurring 2-hour process into about 5 minutes and
				saved 900+ staff-hours annually, and an automated compliance system
				supporting 2,000+ annual notices across 11 teams.
			</p>
			<div class="tech-tags" role="group" aria-label="Technologies used">
				<TechTag src={react.src} label="React" />
				<TechTag src={typescript.src} label="TypeScript" />
				<TechTag src={express.src} label="Express" />
				<TechTag src={python.src} label="Python" />
				<TechTag src={fastapi.src} label="FastAPI" />
				<TechTag src={dotnet.src} label=".NET" />
				<TechTag src={csharp.src} label="C#" />
				<TechTag src={sql.src} label="SQL" />
				<TechTag src={kubernetes.src} label="Kubernetes" />
			</div>
		</li>

		<li>
			<h3>
				National University of Singapore
				<InlineIcon src={nus.src} />
			</h3>
			<p class="experience-meta">
				<span>Software Engineer (Contract)</span>
				<span>Aug 2024 - Dec 2025</span>
			</p>
			<p>
				I served as the lead developer for an educational Unity simulation
				designed for NUS Open House 2026. Collaborating with researchers and
				designers, I transformed complex scientific concepts into interactive
				learning experiences while making key technical decisions around
				architecture, gameplay, and deployment. One of my biggest challenges was
				optimising the WebGL build, reducing its size from over 150 MB to 30 MB
				without compromising the learning experience.
			</p>
			<div class="tech-tags" role="group" aria-label="Technologies used">
				<TechTag src={unity.src} label="Unity" />
				<TechTag src={csharp.src} label="C#" />
			</div>
		</li>

		<li>
			<h3>
				PSA Singapore
				<InlineIcon src={psa.src} />
			</h3>
			<p class="experience-meta">
				<span>Software Engineer Intern</span>
				<span>May 2025 - Aug 2025</span>
			</p>
			<p>
				I contributed to two of PSA Singapore's enterprise AI initiatives: an
				internal AI assistant platform and Project Moonshot, an LLM evaluation
				framework. The experience allowed me to work across the full software
				lifecycle while gaining first-hand exposure to how enterprise AI systems
				are built, evaluated, and prepared for production use.
			</p>
			<div class="tech-tags" role="group" aria-label="Technologies used">
				<TechTag src={react.src} label="React" />
				<TechTag src={express.src} label="Express" />
				<TechTag src={docker.src} label="Docker" />
				<TechTag src={azure.src} label="Azure" />
				<TechTag src={python.src} label="Python" />
			</div>
		</li>
	</ol>
</section>

<style>
	.timeline {
		position: relative;
		display: grid;
		gap: 2rem;
		padding: 0;
		margin-top: 2rem;
		list-style: none;
		counter-reset: experience;
	}

	.timeline::before {
		position: absolute;
		inset-block: 0;
		left: 1.1rem;
		border-left: 1px solid var(--muted);
		content: '';
	}

	.timeline li {
		position: relative;
		padding-left: 3.5rem;
		counter-increment: experience;
	}

	.timeline li::before {
		position: absolute;
		inset: 0 auto auto 0;
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border: 1px solid var(--muted);
		border-radius: 50%;
		background: var(--white);
		content: counter(experience);
	}

	.experience-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-bottom: 0.5rem; /* Overrides default <p> margin */
		color: var(--muted);
	}

	.tech-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
</style>
