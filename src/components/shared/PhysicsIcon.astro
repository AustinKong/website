---
interface Props {
	label: string;
	class?: string;
	size?: string;
}

const { label, class: className = '', size = '1em' } = Astro.props;
---

<span
	class:list={['physics-icon', className]}
	data-physics-icon
	role="button"
	tabindex="0"
	aria-label={`Drop ${label}`}
	style={`--physics-icon-size:${size}`}
>
	<span data-physics-icon-template aria-hidden="true">
		<slot />
	</span>
</span>

<script>
	import { registerPhysicsIconBindings } from './physicsIconRuntime';

	registerPhysicsIconBindings();
</script>
