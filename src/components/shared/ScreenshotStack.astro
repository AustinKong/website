---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface ImageItem {
	src: ImageMetadata;
	caption: string;
}

interface Props {
	images: ImageItem[];
}

const { images } = Astro.props;
---

<div class="screenshot-stack">
	{
		images.map(({ src, caption }) => (
			<figure>
				<Image
					{src}
					alt={caption}
					width={960}
					draggable="false"
				/>
				<figcaption>{caption}</figcaption>
			</figure>
		))
	}
</div>

<style>
	.screenshot-stack {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		margin: 3rem 0;
		padding: clamp(1rem, 4vw, 3rem);
		background: var(--surface);
		border-radius: var(--radius-card);
	}

	figure {
		margin: 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		border: 0;
		border-radius: var(--radius-card);
	}

	figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: var(--font-size-small);
	}
</style>
