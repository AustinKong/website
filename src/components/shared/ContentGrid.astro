---
import Laurel from './Laurel.astro';

interface Item {
	title: string;
	href: string;
	description: string;
	image: string;
	imageAlt: string;
	stat?: string;
}

interface Props {
	items: Item[];
	cardHeadingLevel?: 2 | 3;
	limitOnSingleColumn?: boolean;
}

const {
	items,
	cardHeadingLevel = 2,
	limitOnSingleColumn = false,
} = Astro.props;
const CardHeading = cardHeadingLevel === 2 ? 'h2' : 'h3';
---

<div
	class:list={[
		'content-grid',
		{ 'content-grid--limited': limitOnSingleColumn },
	]}
>
	{
		items.map((item) => (
			<article class="content-card">
				<a class="content-card__link" href={item.href}>
					<div class="content-card__media">
						<img src={item.image} alt={item.imageAlt} loading="lazy" />
					</div>

					<div class="content-card__heading">
						<CardHeading class="content-card__title">{item.title}</CardHeading>
						{item.stat && <Laurel text={item.stat} />}
					</div>
					<p>{item.description}</p>
				</a>
			</article>
		))
	}
</div>

<style>
	.content-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
		gap: 3.5rem 1rem;
	}

	.content-card__media {
		display: grid;
		aspect-ratio: 9 / 10;
		margin-bottom: 1rem;
		overflow: hidden;
		border-radius: var(--radius-card);
		background: var(--surface);
	}

	.content-card__link {
		display: block;
		text-decoration: none;
	}

	.content-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.content-card__title {
		min-width: 0;
		margin-bottom: 0.25rem;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.18em;
		transition: text-decoration-color var(--transition);
	}

	.content-card__heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.content-card__link:hover .content-card__title,
	.content-card__link:focus-visible .content-card__title {
		text-decoration-color: currentColor;
	}

	.content-card p {
		margin: 0;
	}

	@media (max-width: 36rem) {
		.content-grid--limited .content-card:nth-child(n + 4) {
			display: none;
		}
	}
</style>
