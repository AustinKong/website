---
import ArrowTopRight from '../assets/arrow-top-right.svg';
import ArrowRight from '../assets/arrow-right.svg';
import PillButton from './PillButton.astro';

const socials = [
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/konghoitec',
	},
	{
		label: 'Telegram',
		href: 'https://t.me/austinkong',
	},
	{
		label: 'GitHub',
		href: 'https://github.com/austinkong',
	},
];
---

<section id="contact" class="contact home-section section--wide">
	<h1>Contact</h1>

	<div class="contact__grid">
		<section>
			<h2>Socials</h2>
			<ul class="contact__links">
				{
					socials.map((social) => (
						<li>
							<PillButton
								text={social.label}
								href={social.href}
								target="_blank"
								rel="noreferrer"
							>
								<ArrowTopRight slot="icon" />
							</PillButton>
						</li>
					))
				}
				<li>
					<PillButton text="Blog" href="/blog">
						<ArrowRight slot="icon" />
					</PillButton>
				</li>
			</ul>
		</section>

		<section>
			<h2>Email</h2>
			<p>
				For work, collaborations and recruiters, reach me at
				<a href="mailto:konghoitec@u.nus.edu">konghoitec@u.nus.edu</a>.
			</p>
		</section>
	</div>
</section>

<style>
	.contact__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 5rem clamp(3rem, 8vw, 8rem);
		align-items: start;
	}

	.contact__links {
		display: flex;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
		gap: 0.75rem;
		list-style: none;
	}

	@media (max-width: 700px) {
		.contact__grid {
			grid-template-columns: 1fr;
			gap: 4rem;
		}
	}
</style>
