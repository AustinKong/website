---
import ddia from '../../assets/currently/ddia.png';
import notebook from '../../assets/currently/notebook.png';
import thinkpad from '../../assets/currently/thinkpad.png';
import Profile from '../Profile.astro';
import ObjectGallery from '../shared/ObjectGallery.astro';

const objects = [
	{
		src: ddia,
		alt: 'Designing Data-Intensive Applications',
		caption: 'Currently reading:\nDDIA',
	},
	{
		src: thinkpad,
		alt: 'ThinkPad laptop',
		caption: 'Currently building:\n',
		link: {
			text: 'Logos',
			href: '/#projects',
		},
	},
	{
		src: notebook,
		alt: 'Open notebook',
		caption: 'Currently exploring:\nagentic AI',
	},
];
---

<section id="about" class="home-section section--narrow">
	<div class="mobile-profile">
		<Profile />
	</div>
	<h1>
		Hello there! I'm Austin Kong, a full-stack software engineer and final-year
		Information Systems student at NUS.
	</h1>
	<p>
		I believe that software should solve problems, but the code behind it can be
		beautiful. I strive to write systems that are both technically sound and
		thoughtfully designed.
	</p>
	<p>
		Over the past few years, I've worked on enterprise AI platforms, distributed
		backend services, and interactive web applications. I enjoy working across
		the entire stack: from designing intuitive user interfaces to architecting
		reliable backend systems that power them.
	</p>
	<p>
		Outside of work, I enjoy building personal projects, exploring new
		technologies, and continually refining my craft as an engineer. Here's what
		I'm up to these days:
	</p>
	<ObjectGallery objects={objects} />
</section>

<style>
	.mobile-profile {
		display: none;
	}

	@media (max-width: 900px) {
		.mobile-profile {
			display: block;
			margin-bottom: 1rem;
		}
	}
</style>
