---
import type { ImageMetadata } from 'astro';

interface Props {
	src: string | ImageMetadata;
	caption: string;
	size?: 'large' | 'medium' | 'small';
}

const { src, caption, size = 'large' } = Astro.props;
---

<figure class={size}>
	<img
		src={typeof src === 'string' ? src : src.src}
		width={typeof src === 'string' ? undefined : src.width}
		height={typeof src === 'string' ? undefined : src.height}
		alt={caption}
		loading="lazy"
	/>
	<figcaption>{caption}</figcaption>
</figure>

<style>
	figure {
		margin: 2rem auto;
	}

	figure.large {
		width: 100%;
	}

	figure.medium {
		width: 75%;
	}

	figure.small {
		width: 50%;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-card);
	}

	figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: var(--font-size-small);
	}

	@media (max-width: 40rem) {
		figure:is(.medium, .small) {
			width: 100%;
		}
	}
</style>
