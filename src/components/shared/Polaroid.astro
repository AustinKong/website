---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
}

const { src, alt } = Astro.props;
---

<figure>
	<Image {src} {alt} width={288} />
	<figcaption><slot /></figcaption>
</figure>

<style>
	figure {
		width: min(16rem, calc(100vw - 3rem));
		margin: 0;
		padding: 0.75rem 0.75rem 1rem;
		background: var(--surface);
		box-shadow: 0 0.5rem 1.5rem var(--shadow);
		text-align: center;
		transform: rotate(var(--polaroid-rotation, -3deg));
		transition:
			box-shadow var(--transition),
			transform var(--transition);
	}

	figure:hover {
		box-shadow: 0 1rem 2rem var(--shadow);
		transform: translateY(-0.5rem)
			rotate(calc(var(--polaroid-rotation, -3deg) + 2deg));
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		padding-top: 0.75rem;
	}

	@media (prefers-reduced-motion: reduce) {
		figure {
			transition: none;
		}
	}
</style>
