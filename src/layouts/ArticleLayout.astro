---
import ArrowLeft from '../assets/arrow-left.svg';
import ArrowTopRight from '../assets/arrow-top-right.svg';
import ArrowUp from '../assets/arrow-up.svg';
import GitHub from '../assets/icons/github.svg';
import InlineIcon from '../components/shared/InlineIcon.astro';
import PillButton from '../components/shared/PillButton.astro';
import TechnologyList from '../components/shared/TechnologyList.astro';
import type { Technology } from '../data/technologies';
import MainLayout from './MainLayout.astro';

interface Props {
	title: string;
	description?: string;
	navItems: {
		label: string;
		href: string;
		depth?: number;
	}[];
	backHref: string;
	backLabel: string;
	technologies?: Technology[];
	links?: {
		label: string;
		href: string;
		kind: 'github' | 'external';
	}[];
}

const {
	title,
	description,
	navItems,
	backHref,
	backLabel,
	technologies = [],
	links = [],
} = Astro.props;

const linkIcons = {
	github: GitHub.src,
	external: ArrowTopRight.src,
};
---

<MainLayout {title} {description} {navItems}>
	<article id="top" class="section--narrow">
		<header>
			<div class="article-actions">
				<nav aria-label="Back">
					<PillButton href={backHref} inverted>
						<InlineIcon src={ArrowLeft.src} />
						{backLabel}
					</PillButton>
				</nav>
				{
					links.length > 0 && (
						<nav class="project-links" aria-label="Project links">
							{links.map(({ label, href, kind }) => (
								<PillButton {href} target="_blank" rel="noreferrer">
									<InlineIcon src={linkIcons[kind]} />
									{label}
								</PillButton>
							))}
						</nav>
					)
				}
			</div>
			<h1>{title}</h1>
			{description && <p>{description}</p>}
			{technologies.length > 0 && <TechnologyList {technologies} />}
		</header>

		<div class="prose">
			<slot />
		</div>

		<footer>
			<PillButton href="#top" inverted>
				<InlineIcon src={ArrowUp.src} />
				Back to Top
			</PillButton>
		</footer>
	</article>
</MainLayout>

<style>
	:global(body) {
		overflow-x: clip;
	}

	article > header {
		margin-bottom: 4rem;
	}

	.article-actions {
		display: flex;
		margin-bottom: 2rem;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.prose {
		overflow-wrap: anywhere;
	}

	.prose :global(:is(h2, h3, h4)) {
		margin-top: 2em;
	}

	.prose :global(:is(p, ul, ol, blockquote, pre)) {
		margin: 0 0 1.2em;
	}

	.prose :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.75rem 1rem;
		border-left: 0.25rem solid var(--foreground);
		background: var(--surface);
		font-style: italic;
	}

	.prose :global(blockquote p:last-child) {
		margin-bottom: 0;
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
	}

	.prose :global(pre) {
		overflow-x: auto;
		padding: 1rem;
		background: var(--surface);
		font-family: monospace;
		font-size: var(--font-size-small);
	}

	.prose :global(pre.mermaid) {
		justify-content: flex-start;
	}

	.prose :global(pre.mermaid > svg) {
		flex: 0 0 auto;
		width: auto !important;
		max-width: none !important;
	}

	article > footer {
		margin-top: 2rem;
	}
</style>
