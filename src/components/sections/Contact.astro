---
import ArrowRight from '../../assets/arrow-right.svg';
import GitHub from '../../assets/icons/github.svg';
import LinkedIn from '../../assets/icons/linkedin.svg';
import Telegram from '../../assets/icons/telegram.svg';
import InlineIcon from '../shared/InlineIcon.astro';
import PillButton from '../shared/PillButton.astro';

const socials = [
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/konghoitec',
		icon: LinkedIn,
	},
	{
		label: 'Telegram',
		href: 'https://t.me/austinkong',
		icon: Telegram,
	},
	{
		label: 'GitHub',
		href: 'https://github.com/austinkong',
		icon: GitHub,
	},
];
---

<section id="contact" class="home-section">
	<h2>Contact</h2>

	<div class="contact__grid">
		<section>
			<h3>Socials</h3>
			<ul class="contact__links">
				{
					socials.map(({ label, href, icon }) => (
						<li>
							<PillButton href={href} target="_blank" rel="noreferrer">
								<InlineIcon src={icon.src} />
								{label}
							</PillButton>
						</li>
					))
				}
				<li>
					<PillButton href="/blog">
						Blog
						<InlineIcon src={ArrowRight.src} />
					</PillButton>
				</li>
			</ul>
		</section>

		<section>
			<h3>Email</h3>
			<p>
				For work, collaborations and recruiters, reach me at
				<a href="mailto:konghoitec@u.nus.edu">konghoitec@u.nus.edu</a>.
			</p>
		</section>
	</div>
</section>

<style>
	.contact__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 5rem clamp(3rem, 8vw, 8rem);
		align-items: start;
	}

	.contact__links {
		display: flex;
		padding: 0;
		flex-wrap: wrap;
		gap: 0.75rem;
		list-style: none;
	}

	@media (max-width: 700px) {
		.contact__grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
