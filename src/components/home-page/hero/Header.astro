---
import ThemeIcon from '../../ThemeIcon.astro';
import ColorPicker from './ColorPicker.astro';
import GitHubCommits from './GitHubCommits.astro';
import SingaporeWeatherTime from './SingaporeWeatherTime.astro';
import DirectionalSwap from '../../shared/DirectionalSwap.astro';
import Globe from '../../../assets/globe.svg';

interface NavItem {
	label: string;
	href: string;
}

const navItems: NavItem[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Recommended Reads', href: '#reads' },
	{ label: 'About', href: '#about' },
	{ label: 'Blog', href: '/blog' },
];

const siteName = 'Austin Kong';
---

<style>
	nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
	}

	.hero-nav__spacer {
		flex: 1;
	}

	.hero-nav__secondary {
		display: flex;
		align-items: start;
		gap: 1rem;
		padding: 0 1rem 1rem;
		box-sizing: border-box;
		justify-content: space-between;
	}

	.hero-nav__secondary-left {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.hero-nav__secondary-spacer {
		flex: 1;
	}

	.hero-nav__secondary-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.hero-nav__group {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.45rem;
	}

	.hero-nav__meta-body {
		display: contents;
	}

	.hero-nav__activity {
		display: contents;
	}

	.hero-nav__activity-body {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.hero-nav__label {
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.2;
		text-transform: uppercase;
		color: #221f1d;
		white-space: nowrap;
		padding-top: 0.02rem;
		margin: 0;
	}

	.nav-item {
		padding: 0.5rem;
		margin: 0;
		background: #221f1d;
		text-transform: uppercase;
		display: flex;
		align-items: stretch;
		height: 3rem;
		gap: 0.5rem;
	}

	.nav-item .inverted-content {
		background: #eae2d5;
		margin: 0;
		padding: 0.2rem;
		box-sizing: border-box;
		color: #221f1d;
	}

	.nav-item .globe-svg {
		height: 100%;
	}

	.nav-item > * {
		height: 100%;
	}

	.nav-item p {
		margin: 0;
		font-size: 1.5rem;
		display: flex;
		align-items: center;
	}

	.nav-item .motion-swap {
		height: 100%;
		display: flex;
		align-items: center;
	}

	.nav-item-swap {
		font-size: 1.5rem;
	}

	.nav-item-swap [slot='primary'],
	.nav-item-swap [slot='secondary'] {
		font-size: 1.5rem;
		font-weight: inherit;
		display: flex;
		align-items: center;
	}
</style>

<nav class="hero-nav" aria-label="Primary">
	<div class="nav-item">
		<figure aria-hidden="true" class="inverted-content">
			<Globe class="globe-svg" />
		</figure>
		<p>© Austin Kong</p>
		<p class="inverted-content">W W W</p>
	</div>

	<div class="spacer"></div>
	<div class="hero-nav__spacer"></div>
	{
		navItems.map((item) => (
			<a href={item.href} class="nav-item motion-parent">
				<DirectionalSwap
					class="nav-item-swap"
					direction="down"
					distance="100%"
					durationMs={420}
					trigger="parent"
					ariaHidden={false}
				>
					<span slot="primary">{item.label}</span>
					<span slot="secondary">{item.label}</span>
				</DirectionalSwap>
			</a>
		))
	}
</nav>

<div class="hero-nav__secondary">
	<div class="hero-nav__secondary-left">
		<div class="hero-nav__group">
			<p class="hero-nav__label">Activity:</p>
			<div class="hero-nav__activity">
				<div class="hero-nav__activity-body">
					<GitHubCommits />
				</div>
			</div>
		</div>
		<div class="hero-nav__group">
			<p class="hero-nav__label">Sg:</p>
			<div class="hero-nav__meta-body">
				<SingaporeWeatherTime />
			</div>
		</div>
	</div>
	<div class="hero-nav__secondary-right">
		<ColorPicker />
	</div>
</div>
