---
const latitude = 1.352083;
const longitude = 103.819839;
const timezone = 'Asia/Singapore';
---

<div
	class="sg-weather-time"
	data-latitude={String(latitude)}
	data-longitude={String(longitude)}
	data-timezone={timezone}
>
	<span class="sg-weather-time__content">--:--:-- | --.-°C | Rain --.-mm</span>
</div>

<style>
	.sg-weather-time {
		display: inline-block;
		pointer-events: none;
		color: #221f1d;
	}

	.sg-weather-time__content {
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.2;
		color: #221f1d;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:global(html.dark) .sg-weather-time__content {
		color: #221f1d;
	}
</style>

<script>
	// @ts-nocheck

	const WEATHER_CACHE_PREFIX = 'sg-weather-cache-v1';
	const WEATHER_TTL_MS = 10 * 60 * 1000;
	const CLOCK_TICK_MS = 1000;

	function readWeatherCache(key) {
		try {
			const raw = localStorage.getItem(key);
			if (!raw) return null;

			const parsed = JSON.parse(raw);
			if (!parsed || typeof parsed !== 'object') return null;

			if (typeof parsed.timestamp !== 'number' || !parsed.weather) return null;

			if (Date.now() - parsed.timestamp > WEATHER_TTL_MS) return null;

			return parsed.weather;
		} catch (_error) {
			return null;
		}
	}

	function writeWeatherCache(key, weather) {
		try {
			localStorage.setItem(
				key,
				JSON.stringify({
					timestamp: Date.now(),
					weather,
				})
			);
		} catch (_error) {
			// Ignore
		}
	}

	function formatSingaporeClock(timezone) {
		const now = new Date();
		return now.toLocaleTimeString('en-SG', {
			timeZone: timezone,
			hour12: false,
			hour: '2-digit',
			minute: '2-digit',
			second: '2-digit',
		});
	}

	function formatWeather(weather) {
		const temp = Number.isFinite(weather?.temperature)
			? weather.temperature.toFixed(1)
			: '--.-';
		const precip = Number.isFinite(weather?.precipitation)
			? weather.precipitation.toFixed(1)
			: '--.-';

		return `${temp}°C | Rain ${precip}mm`;
	}

	function updateContent(element, timezone, weather) {
		const time = formatSingaporeClock(timezone);
		const weatherStr = formatWeather(weather);
		element.textContent = `${time} | ${weatherStr}`;
	}

	async function fetchSingaporeWeather(latitude, longitude, timezone) {
		const query = new URLSearchParams({
			latitude: String(latitude),
			longitude: String(longitude),
			current: 'temperature_2m,precipitation',
			timezone,
			forecast_days: '1',
		});
		const url = `https://api.open-meteo.com/v1/forecast?${query.toString()}`;

		const response = await fetch(url);
		if (!response.ok) {
			throw new Error(
				`Open-Meteo request failed with status ${response.status}`
			);
		}

		const payload = await response.json();
		return {
			temperature: payload?.current?.temperature_2m,
			precipitation: payload?.current?.precipitation,
		};
	}

	for (const root of document.querySelectorAll('.sg-weather-time')) {
		const contentSpan = root.querySelector('.sg-weather-time__content');
		if (!contentSpan) continue;

		const latitude = Number(root.getAttribute('data-latitude') || '1.352083');
		const longitude = Number(
			root.getAttribute('data-longitude') || '103.819839'
		);
		const timezone = root.getAttribute('data-timezone') || 'Asia/Singapore';
		const cacheKey = `${WEATHER_CACHE_PREFIX}-${latitude}-${longitude}`;

		let weather = readWeatherCache(cacheKey) || {
			temperature: null,
			precipitation: null,
		};

		updateContent(contentSpan, timezone, weather);

		setInterval(() => {
			updateContent(contentSpan, timezone, weather);
		}, CLOCK_TICK_MS);

		(async () => {
			try {
				weather = await fetchSingaporeWeather(latitude, longitude, timezone);
				writeWeatherCache(cacheKey, weather);
				updateContent(contentSpan, timezone, weather);
			} catch (_error) {
				// Keep showing previous data
			}
		})();

		setInterval(async () => {
			try {
				weather = await fetchSingaporeWeather(latitude, longitude, timezone);
				writeWeatherCache(cacheKey, weather);
				updateContent(contentSpan, timezone, weather);
			} catch (_error) {
				// Keep showing previous data
			}
		}, WEATHER_TTL_MS);
	}
</script>
