---
import SplitSection from '../SplitSection.astro';
import ArrowRight from '../../assets/arrow-right.svg';
import ReactIcon from '../../assets/React.svg';
import DirectionalSwap from '../shared/DirectionalSwap.astro';
import UnderlinePopout from '../shared/UnderlinePopout.astro';
import PhysicsIcon from '../shared/PhysicsIcon.astro';

// Tech stack logos
import NodeLogo from '../../assets/Node.js.svg';
import PythonLogo from '../../assets/Python.svg';
import CSharpLogo from '../../assets/CSharp.svg';
import SQLLogo from '../../assets/Microsoft SQL Server.svg';
import RedisLogo from '../../assets/Redis.svg';

const buildSummaryTokens = (summary, highlights = []) => {
	if (!highlights.length) {
		return [{ type: 'text', value: summary }];
	}

	const tokens = [];
	const sortedHighlights = [...highlights].sort(
		(a, b) => b.keyword.length - a.keyword.length
	);
	let cursor = 0;

	while (cursor < summary.length) {
		let nextMatch = null;

		for (const highlight of sortedHighlights) {
			const matchIndex = summary.indexOf(highlight.keyword, cursor);

			if (matchIndex === -1) {
				continue;
			}

			if (!nextMatch || matchIndex < nextMatch.index) {
				nextMatch = {
					index: matchIndex,
					keyword: highlight.keyword,
					icon: highlight.icon,
				};
			}
		}

		if (!nextMatch) {
			tokens.push({ type: 'text', value: summary.slice(cursor) });
			break;
		}

		if (nextMatch.index > cursor) {
			tokens.push({
				type: 'text',
				value: summary.slice(cursor, nextMatch.index),
			});
		}

		tokens.push({
			type: 'highlight',
			value: nextMatch.keyword,
			icon: nextMatch.icon,
		});

		cursor = nextMatch.index + nextMatch.keyword.length;
	}

	return tokens;
};

const journey = [
	{
		company: 'GIC',
		role: 'Software Engineer Intern',
		dates: 'Jan 2026 - Present',
		summary:
			'Developed and enhanced full-stack features for internal equities tooling using React (TypeScript), Node.js (LoopBack 4), Python (FastAPI), .NET/C#, Microsoft SQL, and Redis, deployed on Kubernetes (Red Hat OpenShift). Designed and implemented an automated cache refresh pipeline across 4 microservices, integrating data from an external CMS into enterprise databases and reducing manual operational effort by about 93% for equities research workflows.',
		summaryHighlights: [
			{ keyword: 'React', icon: ReactIcon },
			{ keyword: 'Node.js', icon: NodeLogo },
			{ keyword: 'Python', icon: PythonLogo },
			{ keyword: '.NET/C#', icon: CSharpLogo },
			{ keyword: 'Microsoft SQL', icon: SQLLogo },
			{ keyword: 'Redis', icon: RedisLogo },
		],
	},
	{
		company: 'NUS',
		role: 'Software Engineer',
		dates: 'Aug 2024 - Dec 2025',
		summary:
			'Developed an interactive Unity simulation in C#, applying OOP and event-driven architecture with singleton and state machine design patterns for modular, maintainable software systems. Improved performance and deployment efficiency by reducing WebGL build size by 80% for smoother mobile delivery, while using Git and optimisation techniques to improve scalability and reliability.',
	},
	{
		company: 'NUS',
		role: 'Teaching Assistant, CS2040 Data Structures & Algorithms',
		dates: 'Aug 2025 - Nov 2025',
		summary:
			'Led weekly lab sessions for 26 students in a Java-based data structures and algorithms course, facilitating learning, assessing assignments, and providing tailored guidance to strengthen problem-solving skills.',
	},
	{
		company: 'PSA Singapore',
		role: 'Software Engineer Intern',
		dates: 'May 2025 - Aug 2025',
		summary:
			'Designed and deployed enterprise-grade AI chatbot and RAG platforms using React, Express.js, and Node.js, containerised with Docker and deployed to Azure App Service with Azure Active Directory authentication. Developed Python-based LLM evaluation and testing frameworks, integrating automated benchmarking pipelines to improve AI model reliability as part of the MLOps team.',
	},
];
---

<SplitSection id="about" eyebrow="About" title="About me">
	<div class="about-stack">
		<p class="about-copy">
			I like building useful software, learning across layers of the stack, and
			turning ideas into systems that feel polished in practice. My work spans
			full-stack engineering, cloud deployment, AI tooling, and teaching, and I
			care just as much about maintainability as I do about shipping with
			<UnderlinePopout class="about-copy__react" iconSize="1.25em">
				<ReactIcon slot="icon" />
				react
			</UnderlinePopout>
			in the mix.
		</p>

		<section class="journey">
			<h3 class="journey__title">Career journey</h3>

			<div class="journey__list">
				{
					journey.map((entry, index) => {
						const [startDate, endDate] = entry.dates.split(' - ');
						const summaryTokens = buildSummaryTokens(
							entry.summary,
							entry.summaryHighlights
						);

						return (
							<article class="journey-item motion-parent">
								<p class="journey-item__index">
									{String(index + 1).padStart(2, '0')}
								</p>
								<div class="journey-item__content">
									<div class="journey-item__header">
										<h4 class="journey-item__title">
											{entry.company} - {entry.role}
										</h4>
										<p class="journey-item__dates">
											<span class="journey-item__date">{startDate}</span>
											<DirectionalSwap
												class="journey-item__arrow"
												direction="right"
												distance="110%"
												durationMs={420}
												itemPadding="0.08em 0.14em"
												trigger="parent"
											>
												<span slot="primary" class="journey-item__arrow-item">
													<ArrowRight class="journey-item__arrow-icon" />
												</span>
												<span slot="secondary" class="journey-item__arrow-item">
													<ArrowRight class="journey-item__arrow-icon" />
												</span>
											</DirectionalSwap>
											<span class="journey-item__date">{endDate}</span>
										</p>
									</div>
									<p class="journey-item__summary">
										{summaryTokens.map((token) => {
											if (token.type === 'text') {
												return token.value;
											}

											const TokenIcon = token.icon;

											return (
												<PhysicsIcon
													class="journey-item__summary-popout"
													iconSize="1.05em"
												>
													<TokenIcon slot="icon" />
													{token.value}
												</PhysicsIcon>
											);
										})}
									</p>
								</div>
							</article>
						);
					})
				}
			</div>
		</section>
	</div>
</SplitSection>

<style>
	.about-stack {
		display: grid;
		gap: 2rem;
	}

	.about-copy {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.44rem;
		line-height: 1.8;
	}

	.journey {
		display: grid;
		gap: 1.15rem;
	}

	.journey__title {
		margin: 0;
		color: var(--site-fg);
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.journey__list {
		display: grid;
		gap: 0;
	}

	.journey-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		padding: 1.1rem 0;
		border-top: 1px solid var(--border-subtle);
	}

	.journey-item:last-child {
		border-bottom: 1px solid var(--border-subtle);
	}

	.journey-item__index {
		position: relative;
		display: inline-block;
		padding-inline: 0.72ch;
		margin-top: 0.2rem;
		color: var(--text-soft);
		font-family: 'League Spartan', sans-serif;
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		line-height: 1;
	}

	.journey-item__index::before,
	.journey-item__index::after {
		position: absolute;
		top: 0;
		height: 1em;
		margin: auto 0;
		display: block;
		line-height: 1;
		opacity: 0;
		transition:
			opacity 220ms ease,
			transform 220ms ease;
		transition-delay: 500ms;
		pointer-events: none;
	}

	.journey-item__index::before {
		content: '[';
		left: 0;
		transform: translateX(-0.45ch);
	}

	.journey-item__index::after {
		content: ']';
		right: 0;
		transform: translateX(0.45ch);
	}

	.journey-item:hover .journey-item__index::before,
	.journey-item:hover .journey-item__index::after {
		opacity: 1;
		transition-delay: 0ms;
	}

	.journey-item:hover .journey-item__index::before {
		transform: translateX(0);
	}

	.journey-item:hover .journey-item__index::after {
		transform: translateX(0);
	}

	.journey-item__content {
		display: grid;
		gap: 0.75rem;
		min-width: 0;
	}

	.journey-item__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.journey-item__title {
		margin: 0;
		color: var(--site-fg);
		font-size: 1.55rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	.journey-item__dates {
		margin: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-soft);
		font-size: 1.04rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.journey-item__arrow {
		display: inline-flex;
		width: 1.1em;
		height: 1.1em;
	}

	.journey-item__arrow-item {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.1em;
		height: 1.1em;
	}

	.journey-item__arrow-icon {
		display: block;
		width: 100%;
		height: 100%;
	}

	.journey-item__summary {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.18rem;
		line-height: 1.72;
	}

	.journey-item__summary-popout {
		font: inherit;
		color: inherit;
	}

	@media (max-width: 639px) {
		.journey-item {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
