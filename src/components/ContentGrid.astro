---
interface Item {
	title: string;
	description?: string;
	href?: string;
	image?: string;
	imageAlt?: string;
	label?: string;
	color?: string;
}

interface Props {
	title: string;
	items: Item[];
	id?: string;
	class?: string;
}

const { title, items, id, class: className } = Astro.props;
---

<section id={id} class:list={['content-grid-section', className]}>
	<h1>{title}</h1>

	<div class="content-grid">
		{
			items.map((item) => (
				<article class="content-card">
					{item.href ? (
						<a
							class="content-card__media"
							href={item.href}
							style={`--card-color:${item.color ?? '#e5e5e2'}`}
							aria-label={item.title}
						>
							{item.image ? (
								<img src={item.image} alt={item.imageAlt ?? ''} loading="lazy" />
							) : (
								<span>{item.label}</span>
							)}
						</a>
					) : (
						<div
							class="content-card__media"
							style={`--card-color:${item.color ?? '#e5e5e2'}`}
							aria-label="Project image placeholder"
						>
							<span>{item.label}</span>
						</div>
					)}

					<h2>
						{item.href ? <a href={item.href}>{item.title}</a> : item.title}
					</h2>
					{item.description && <p>{item.description}</p>}
				</article>
			))
		}
	</div>
</section>

<style>
	.content-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 3.5rem 1rem;
	}

	.content-card__media {
		display: grid;
		aspect-ratio: 9 / 10;
		margin-bottom: 1rem;
		place-items: center;
		overflow: hidden;
		border-radius: 0.5rem;
		background: var(--card-color);
		text-decoration: none;
	}

	.content-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.content-card__media span {
		color: rgb(41 41 39 / 0.35);
		font-size: var(--font-size-h1);
	}

	.content-card h2 {
		margin-bottom: 0.25rem;
	}

	.content-card h2 a {
		text-decoration: none;
	}

	.content-card p {
		margin: 0;
	}

	@media (max-width: 700px) {
		.content-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
