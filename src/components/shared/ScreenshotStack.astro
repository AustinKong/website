---
import type { ImageMetadata } from 'astro';

interface ImageItem {
	src: string | ImageMetadata;
	caption: string;
}

interface Props {
	images: ImageItem[];
	background?: string;
}

const { images, background = 'var(--surface)' } = Astro.props;
---

<div class="screenshot-stack" style={`--screenshot-background: ${background}`}>
	{
		images.map(({ src, caption }) => (
			<figure>
				<img
					src={typeof src === 'string' ? src : src.src}
					width={typeof src === 'string' ? undefined : src.width}
					height={typeof src === 'string' ? undefined : src.height}
					alt={caption}
					loading="lazy"
					draggable="false"
				/>
				<figcaption>{caption}</figcaption>
			</figure>
		))
	}
</div>

<style>
	.screenshot-stack {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
		margin: 3rem 0;
		padding: clamp(1rem, 4vw, 3rem);
		background: var(--screenshot-background);
		border-radius: var(--radius-card);
	}

	figure {
		margin: 0;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
		border: 0;
		border-radius: var(--radius-card);
	}

	figcaption {
		margin-top: 0.75rem;
		text-align: center;
		font-size: var(--font-size-small);
	}
</style>
