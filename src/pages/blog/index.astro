---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

// Get all blog posts and filter out drafts
const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<MainLayout title="Blog" description="Read my latest blog posts">
	<div class="blog-list-page">
		<h1 class="blog-list-page__title">Blog</h1>
		<p class="blog-list-page__intro">
			Thoughts, insights, and updates from my journey.
		</p>

		{
			posts.length === 0 ? (
				<div class="blog-list-page__empty">
					<p>No blog posts yet. Check back soon!</p>
				</div>
			) : (
				<div class="blog-list-page__posts">
					{posts.map((post) => (
						<article class="blog-list-page__post">
							<h2 class="blog-list-page__post-title">
								<a
									href={`/blog/${post.id.replace(/\.md$/, '')}`}
									class="blog-list-page__post-link"
								>
									{post.data.title}
								</a>
							</h2>
							<div class="blog-list-page__meta">
								<time datetime={post.data.date.toISOString()}>
									{post.data.date.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
								{post.data.author && <span>{post.data.author}</span>}
								{post.data.readingTime && <span>{post.data.readingTime}</span>}
							</div>
							{post.data.description && (
								<p class="blog-list-page__description">
									{post.data.description}
								</p>
							)}
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="blog-list-page__tags">
									{post.data.tags.map((tag) => (
										<span class="blog-list-page__tag">{tag}</span>
									))}
								</div>
							)}
							<a
								href={`/blog/${post.id.replace(/\.md$/, '')}`}
								class="blog-list-page__read-more"
							>
								Read more →
							</a>
						</article>
					))}
				</div>
			)
		}
	</div>
</MainLayout>

<style>
	.blog-list-page {
		padding-block: 3rem;
	}

	.blog-list-page__title {
		margin: 0;
		font-size: 2.25rem;
		font-weight: 700;
		color: rgb(17 24 39);
	}

	.blog-list-page__intro {
		margin: 1rem 0 0;
		font-size: 1.125rem;
		color: rgb(75 85 99);
	}

	.blog-list-page__empty {
		margin-top: 3rem;
		border: 1px solid rgb(229 231 235);
		border-radius: 0.5rem;
		background-color: rgb(249 250 251);
		padding: 2rem;
		text-align: center;
		color: rgb(75 85 99);
	}

	.blog-list-page__posts {
		margin-top: 3rem;
		display: grid;
		gap: 2rem;
	}

	.blog-list-page__post {
		padding-bottom: 2rem;
		border-bottom: 1px solid rgb(229 231 235);
	}

	.blog-list-page__post:last-child {
		border-bottom: 0;
	}

	.blog-list-page__post-title {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		color: rgb(17 24 39);
	}

	.blog-list-page__post-link {
		color: inherit;
		text-decoration: none;
		transition: color 200ms ease;
	}

	.blog-list-page__post-link:hover {
		color: rgb(75 85 99);
	}

	.blog-list-page__meta {
		margin-top: 0.5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.875rem;
		color: rgb(107 114 128);
	}

	.blog-list-page__description {
		margin: 1rem 0 0;
		color: rgb(55 65 81);
	}

	.blog-list-page__tags {
		margin-top: 1rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.blog-list-page__tag {
		display: inline-block;
		border-radius: 9999px;
		background-color: rgb(229 231 235);
		padding: 0.25rem 0.75rem;
		font-size: 0.875rem;
		color: rgb(31 41 55);
	}

	.blog-list-page__read-more {
		margin-top: 1rem;
		display: inline-block;
		font-weight: 600;
		color: rgb(17 24 39);
		text-decoration: none;
		transition: color 200ms ease;
	}

	.blog-list-page__read-more:hover {
		color: rgb(75 85 99);
	}

	:global(html.dark) .blog-list-page__title,
	:global(html.dark) .blog-list-page__post-title,
	:global(html.dark) .blog-list-page__read-more {
		color: rgb(243 244 246);
	}

	:global(html.dark) .blog-list-page__intro,
	:global(html.dark) .blog-list-page__empty,
	:global(html.dark) .blog-list-page__meta {
		color: rgb(209 213 219);
	}

	:global(html.dark) .blog-list-page__description {
		color: rgb(229 231 235);
	}

	:global(html.dark) .blog-list-page__tag {
		background-color: rgb(55 65 81);
		color: rgb(243 244 246);
	}

	:global(html.dark) .blog-list-page__post,
	:global(html.dark) .blog-list-page__empty {
		border-color: rgb(75 85 99);
	}

	:global(html.dark) .blog-list-page__empty {
		background-color: rgb(17 24 39 / 0.35);
	}
</style>
