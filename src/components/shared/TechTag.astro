---
import { technologies, type Technology } from '../../data/technologies';
import InlineIcon from './InlineIcon.astro';

interface Props {
	technology: Technology;
}

const { technology } = Astro.props;
const { icon, label } = technologies[technology];
---

<span
	data-physics-object
	role="button"
	tabindex="0"
	aria-label={`Activate ${label} physics`}
>
	<span data-physics-template>
		<InlineIcon src={icon} />
		{label}
	</span>
</span>

<script>
	import { registerPhysicsBindings } from './physicsRuntime';

	registerPhysicsBindings();
</script>

<style>
	:global(.physics-object-layer) {
		position: absolute;
		z-index: 10;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
	}

	:global(.physics-object-body) {
		position: absolute;
		inset: 0 auto auto 0;
		display: grid;
		place-items: center;
		pointer-events: auto;
		touch-action: none;
		cursor: grab;
		will-change: transform;
	}

	:global(.physics-object-body:active) {
		cursor: grabbing;
	}

	[data-physics-object] {
		display: inline-flex;
		cursor: pointer;
		transition: transform var(--transition);
	}

	[data-physics-object]:nth-child(3n + 1):hover {
		transform: translateY(-0.15rem) rotate(-2deg);
	}

	[data-physics-object]:nth-child(3n + 2):hover {
		transform: translateY(-0.2rem) rotate(1.5deg);
	}

	[data-physics-object]:nth-child(3n):hover {
		transform: translateY(-0.1rem) rotate(-1deg);
	}

	[data-physics-template] {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.5rem;
		border: 1px solid var(--subtle);
		border-radius: var(--radius-pill);
		background: var(--white);
		font-size: var(--font-size-small);
		user-select: none;
		white-space: nowrap;
	}

	[data-physics-object][data-activated='true'] > * {
		visibility: hidden;
	}
</style>
