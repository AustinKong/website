---
import arrowIcon from '../../assets/arrow-top-right.svg';
import gic from '../../assets/experience/gic.png';
import nus from '../../assets/experience/nus.png';
import psa from '../../assets/experience/psa.png';
import InlineIcon from '../shared/InlineIcon.astro';
import PillButton from '../shared/PillButton.astro';
import TechnologyList from '../shared/TechnologyList.astro';
---

<section id="experience" class="home-section section--narrow">
	<h2>Experience</h2>
	<PillButton
		href="/Kong_Hoi_Tec_Resume.pdf"
		inverted
		target="_blank"
		rel="noopener"
	>
		View my resume
		<InlineIcon src={arrowIcon.src} />
	</PillButton>

	<ol class="timeline">
		<li>
			<h3>
				National University of Singapore
				<InlineIcon src={nus.src} />
			</h3>
			<p class="experience-meta">
				<span>Teaching Assistant</span>
				<span>Aug 2025 - Present</span>
			</p>
			<p>
				I currently serve as a Teaching Assistant for CS2040 (Data Structures
				and Algorithms), facilitating weekly lab sessions and mentoring students
				through Java-based programming exercises and developing algorithmic
				thinking.
			</p>
			<TechnologyList technologies={['java']} />
		</li>

		<li>
			<h3>
				GIC
				<InlineIcon src={gic.src} />
			</h3>
			<p class="experience-meta">
				<span>Full-Stack Software Engineer Intern</span>
				<span>Jan 2026 - Jun 2026</span>
			</p>
			<p>
				I joined Public Equities Technology at GIC, where I built production
				software supporting investment teams across the firm. I took worked on
				tasks across the stack , owning projects from requirements gathering
				through to production deployment.
			</p>
			<p>
				Some of my work includes a fault-tolerant caching workflow that reduced
				manual effort by 93%, a self-service metadata platform that saved 900+
				staff-hours annually, and an automated compliance system supporting
				2,000+ annual notices across 11 teams.
			</p>
			<TechnologyList
				technologies={[
					'react',
					'typescript',
					'express',
					'nodejs',
					'python',
					'fastapi',
					'dotnet',
					'csharp',
					'postgresql',
					'kubernetes',
				]}
			/>
		</li>

		<li>
			<h3>
				National University of Singapore
				<InlineIcon src={nus.src} />
			</h3>
			<p class="experience-meta">
				<span>Software Engineer (Contract)</span>
				<span>Aug 2024 - Dec 2025</span>
			</p>
			<p>
				I served as the lead developer for an educational Unity simulation
				designed for NUS Open House 2026. Collaborating with researchers and
				designers, I transformed complex scientific concepts into interactive
				learning experiences while making key technical decisions around
				architecture, gameplay, and deployment.
			</p>
			<TechnologyList technologies={['unity', 'csharp']} />
		</li>

		<li>
			<h3>
				PSA Singapore
				<InlineIcon src={psa.src} />
			</h3>
			<p class="experience-meta">
				<span>Software Engineer Intern</span>
				<span>May 2025 - Aug 2025</span>
			</p>
			<p>
				I contributed to two of PSA Singapore's enterprise AI initiatives: an
				internal AI assistant platform and Project Moonshot, an LLM evaluation
				framework. The experience allowed me to work across the full software
				lifecycle while gaining first-hand exposure to how enterprise AI systems
				are built, evaluated, and prepared for production use.
			</p>
			<TechnologyList
				technologies={[
					'react',
					'express',
					'nodejs',
					'sql-server',
					'docker',
					'azure',
					'python',
				]}
			/>
		</li>
	</ol>
</section>

<style>
	.timeline {
		position: relative;
		display: grid;
		gap: 2rem;
		padding: 0;
		margin-top: 2rem;
		list-style: none;
		counter-reset: experience;
	}

	.timeline::before {
		position: absolute;
		inset-block: 0;
		left: 1.1rem;
		border-left: 1px solid var(--subtle);
		content: '';
	}

	.timeline li {
		position: relative;
		padding-left: 3rem;
		counter-increment: experience;
	}

	.timeline li::before {
		position: absolute;
		inset: 0 auto auto 0;
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		border: 1px solid var(--subtle);
		border-radius: 50%;
		background: var(--white);
		content: counter(experience);
	}

	.experience-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-bottom: 0.5rem; /* Overrides default <p> margin */
		color: var(--muted);
	}
</style>
