---
interface Photo {
	src: string;
	alt: string;
	caption: string;
	link?: {
		text: string;
		href: string;
	};
}

interface Props {
	photos: Photo[];
}

const { photos } = Astro.props;
const angles = ['-3deg', '3deg', '-2deg'];
---

<div class="photo-strip">
	{
		photos.map((photo, index) => (
			<figure>
				<img
					src={photo.src}
					alt={photo.alt}
					loading="lazy"
					style={`--angle:${angles[index % angles.length]}`}
				/>
				<figcaption>
					{photo.caption}
					{photo.link && (
						<>
							{' '}
							<a href={photo.link.href}>{photo.link.text}</a>
						</>
					)}
				</figcaption>
			</figure>
		))
	}
</div>

<style>
	.photo-strip {
		display: flex;
		margin-top: 2rem;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		gap: clamp(1rem, 4vw, 4rem);
	}

	figure {
		display: flex;
		flex: 0 1 12rem;
		flex-direction: column;
		min-width: 0;
		margin: 0;
	}

	img {
		display: block;
		width: 100%;
		max-width: 12rem;
		height: auto;
		max-height: 22rem;
		align-self: center;
		object-fit: contain;
		filter: drop-shadow(0 1rem 0.75rem var(--shadow));
		transform: rotate(var(--angle));
		transition: transform var(--transition);
	}

	figure:hover img,
	figure:focus-within img {
		transform: translateY(-0.25rem) rotate(calc(var(--angle) + 1.5deg));
	}

	figcaption {
		margin-top: 1rem;
		color: var(--foreground);
		line-height: 1;
		text-align: center;
		transition:
			opacity var(--transition),
			transform var(--transition);
		white-space: pre-line;
	}

	@media (hover: hover) {
		figcaption {
			opacity: 0;
			pointer-events: none;
			transform: translateY(-0.5rem);
		}

		figure:hover figcaption,
		figure:focus-within figcaption {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		img,
		figcaption {
			transition: none;
		}
	}
</style>
