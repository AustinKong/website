---
interface Props {
	src: string;
	alt?: string;
	inheritColor?: boolean;
}

const { src, alt = '', inheritColor = false } = Astro.props;
---

{
	inheritColor ? (
		<span
			class="inherit-color"
			style={`--icon: url("${src}")`}
			role={alt ? 'img' : undefined}
			aria-label={alt || undefined}
			aria-hidden={!alt}
		/>
	) : (
		<img {src} {alt} width="16" height="16" draggable="false" />
	)
}

<style>
	img,
	.inherit-color {
		display: inline-block;
		width: 1em;
		height: 1em;
		flex: none;
		object-fit: contain;
		vertical-align: -0.13em;
		-webkit-user-drag: none;
	}

	.inherit-color {
		background: currentColor;
		mask: var(--icon) center / contain no-repeat;
	}
</style>
