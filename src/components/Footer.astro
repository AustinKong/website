---
import DirectionalSwap from './shared/DirectionalSwap.astro';
import ArrowUp from '../assets/arrow-up.svg';
import TrashCan from '../assets/trash-can.svg';

const linkedinUrl = 'https://www.linkedin.com/in/austin-kong/';
const githubUrl = 'https://github.com/AustinKong';
const emailUrl = 'mailto:hello@austinkong.dev';
---

<footer class="site-footer">
	<div class="site-footer__left">
		<p class="site-footer__copyright">
			<span class="site-footer__copyright-icon" aria-hidden="true">&copy;</span>
			<span>2025 Austin Kong</span>
		</p>
		<p class="site-footer__follow">
			View my
			<a
				href={linkedinUrl}
				class="site-footer__link"
				target="_blank"
				rel="noopener noreferrer">LinkedIn</a
			>,
			<a
				href={githubUrl}
				class="site-footer__link"
				target="_blank"
				rel="noopener noreferrer">GitHub</a
			>, or <a href={emailUrl} class="site-footer__link">email me</a>.
		</p>
	</div>

	<div class="site-footer__controls">
		<button
			type="button"
			class="site-footer__icon-button"
			aria-label="Clear floating icons"
			data-icon-clear-btn
		>
			<span class="site-footer__icon-square">
				<TrashCan class="site-footer__trash-icon" />
			</span>
		</button>

		<a
			href="#"
			class="site-footer__to-top motion-parent"
			aria-label="Back to top"
		>
			<span class="site-footer__icon-square">
				<DirectionalSwap
					class="site-footer__to-top-swap"
					direction="up"
					distance="115%"
					durationMs={420}
					itemPadding="0"
					trigger="parent"
				>
					<span slot="primary" class="site-footer__to-top-icon-wrap">
						<ArrowUp class="site-footer__to-top-icon" />
					</span>
					<span slot="secondary" class="site-footer__to-top-icon-wrap">
						<ArrowUp class="site-footer__to-top-icon" />
					</span>
				</DirectionalSwap>
			</span>
		</a>
	</div>
</footer>

<script>
	import { triggerPhysicsIconCleanup } from './shared/physicsIconRuntime';

	const bindFooterCleanupButton = () => {
		document
			.querySelectorAll<HTMLButtonElement>('[data-icon-clear-btn]')
			.forEach((button) => {
				if (button.dataset.cleanupBound === 'true') {
					return;
				}

				button.dataset.cleanupBound = 'true';
				button.addEventListener('click', (event) => {
					event.preventDefault();
					triggerPhysicsIconCleanup();
				});
			});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', bindFooterCleanupButton, {
			once: true,
		});
	} else {
		bindFooterCleanupButton();
	}

	document.addEventListener('astro:page-load', bindFooterCleanupButton);
</script>

<style>
	.site-footer {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem;
		color: var(--site-fg);
	}

	.site-footer__left {
		display: grid;
		gap: 0.24rem;
		min-width: 0;
	}

	.site-footer__copyright,
	.site-footer__follow {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.site-footer__copyright {
		display: inline-flex;
		align-items: center;
		gap: 0.24rem;
	}

	.site-footer__copyright-icon {
		font-size: 1em;
	}

	.site-footer__follow {
		white-space: normal;
	}

	.site-footer__link {
		text-decoration: underline;
		text-decoration-thickness: 0.11em;
		text-underline-offset: 0.16em;
		transition: opacity 180ms ease;
	}

	.site-footer__link:hover,
	.site-footer__link:focus-visible {
		opacity: 0.72;
	}

	.site-footer__controls {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.site-footer__icon-button,
	.site-footer__to-top {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		text-decoration: none;
		color: #221f1d;
	}

	.site-footer__icon-button {
		cursor: pointer;
	}

	.site-footer__icon-square {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.45rem;
		height: 2.45rem;
		padding: 0.42rem;
		background: #ffffff;
		border: 1px solid #221f1d;
		box-sizing: border-box;
	}

	.site-footer__trash-icon {
		display: block;
		width: 100%;
		height: 100%;
	}

	.site-footer__to-top-swap {
		height: 100%;
		width: 100%;
	}

	.site-footer__to-top-icon-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		width: 100%;
	}

	.site-footer__to-top-icon {
		display: block;
		height: 100%;
		width: 100%;
	}

	@media (max-width: 640px) {
		.site-footer {
			align-items: flex-start;
		}

		.site-footer__icon-square {
			width: 2.25rem;
			height: 2.25rem;
			padding: 0.36rem;
		}
	}
</style>
