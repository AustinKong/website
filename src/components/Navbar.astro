---
import { Image } from 'astro:assets';
import BlueCheck from '../assets/blue-check.svg';
import profilePicture from '../assets/profile-picture.jpg';

interface Props {
	items?: {
		label: string;
		href: string;
	}[];
}

const { items = [] } = Astro.props;
---

<aside class="sidebar">
	<a class="profile" href="/">
		<Image src={profilePicture} alt="" width={96} height={96} />
		<span class="profile__text">
			<span class="profile__name-row">
				<span class="profile__name">Austin Kong</span>
				<span class="profile__verified" aria-label="Verified">
					<BlueCheck aria-hidden="true" />
				</span>
			</span>
			<span class="profile__role">Final Year Information Systems @ NUS</span>
		</span>
	</a>

	{
		items.length > 0 && (
			<nav class="desktop-nav" aria-label="On this page">
				{items.map((item, index) => (
					<a
						class="nav-link"
						href={item.href}
						aria-current={index === 0 ? 'page' : undefined}
					>
						<span class="nav-link__marker">{index + 1}</span>
						<span>{item.label}</span>
					</a>
				))}
			</nav>
		)
	}
</aside>

<script>
	const sectionLinks = [
		...document.querySelectorAll<HTMLAnchorElement>(
			'.desktop-nav a[href*="#"]'
		),
	];
	const sections = sectionLinks
		.map((link) => document.querySelector<HTMLElement>(link.hash))
		.filter((section): section is HTMLElement => section !== null);

	if (sections.length) {
		const updateActiveSection = () => {
			const active =
				scrollY + innerHeight >= document.documentElement.scrollHeight - 1
					? sections.at(-1)
					: (sections.findLast(
							(section) =>
								section.getBoundingClientRect().top <= innerHeight * 0.4
						) ?? sections[0]);

			sectionLinks.forEach((link) => {
				if (link.hash === `#${active.id}`)
					link.setAttribute('aria-current', 'page');
				else link.removeAttribute('aria-current');
			});
		};

		updateActiveSection();
		addEventListener('scroll', updateActiveSection, { passive: true });
	}
</script>

<style>
	.sidebar {
		position: sticky;
		top: 0;
		display: flex;
		height: 100vh;
		flex-direction: column;
		align-items: flex-start;
		padding: 3rem 2rem 1.25rem;
	}

	.profile {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		text-decoration: none;
	}

	.profile img {
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		object-fit: cover;
	}

	.profile__text {
		display: grid;
		gap: 0.15rem;
	}

	.profile__name-row {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.profile__name {
		font-size: var(--font-size-h2);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	.profile__verified {
		width: 1.2rem;
		height: 1.2rem;
		flex: none;
	}

	.profile__verified svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.profile__role {
		color: var(--muted);
	}

	.desktop-nav {
		position: relative;
		display: grid;
		width: 100%;
		margin-top: 3rem;
		gap: 1rem;
		line-height: 1.25;
	}

	.desktop-nav::before {
		position: absolute;
		top: 1.1rem;
		bottom: 1.1rem;
		left: 1.1rem;
		border-left: 1px solid var(--muted);
		content: '';
	}

	.nav-link {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		text-decoration: none;
	}

	.nav-link__marker {
		position: relative;
		z-index: 1;
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		flex: none;
		place-items: center;
		border: 1px solid var(--muted);
		border-radius: 50%;
		background: var(--white);
		transition:
			background var(--transition),
			color var(--transition),
			border-color var(--transition);
	}

	.nav-link:hover .nav-link__marker {
		border-color: var(--foreground);
	}

	.nav-link[aria-current='page'] .nav-link__marker {
		border-color: var(--foreground);
		background: var(--foreground);
		color: var(--white);
	}

	@media (max-width: 900px) {
		.sidebar {
			position: static;
			min-height: 4.5rem;
			height: auto;
			flex-direction: row;
			align-items: center;
			padding: 0.75rem 1.25rem;
		}

		.profile {
			flex-direction: row;
			align-items: center;
			gap: 0.75rem;
		}

		.profile img {
			width: 3rem;
			height: 3rem;
		}

		.profile__role {
			font-size: 0.8rem;
		}

		.desktop-nav {
			display: none;
		}
	}
</style>
