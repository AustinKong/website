---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="split-section">
	<div class="split-section__grid">
		<div class="split-section__heading">
			<p class="split-section__eyebrow">
				{eyebrow}
			</p>
			<h2 class="split-section__title">
				{title}
			</h2>
		</div>

		<div class="split-section__content">
			<slot />
		</div>
	</div>
</section>

<style>
	.split-section {
		padding: 5rem 0;
	}

	.split-section__grid {
		margin-inline: auto;
		display: grid;
		width: 100%;
		max-width: 100rem;
	}

	.split-section__heading {
		max-width: 16rem;
	}

	.split-section__eyebrow {
		margin: 0;
		color: var(--text-soft);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}

	.split-section__title {
		margin: 1rem 0 0;
		color: var(--site-fg);
		font-size: 3rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.split-section__content {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 640px) {
		.split-section {
			padding-inline: 1.5rem;
		}

		.split-section__title {
			font-size: 3.25rem;
		}
	}

	@media (min-width: 1024px) {
		.split-section {
			padding-inline: 2rem;
		}

		.split-section__grid {
			grid-template-columns: minmax(0, 0.25fr) minmax(0, 0.75fr);
			gap: 2rem;
			align-items: start;
		}
	}
</style>
